{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:image="http://www.google.com/schemas/sitemap-image/1.1">
  {{ $searchIndexFrom := time.AsTime (.Site.Params.searchIndexFrom | default "1970-01-01") }}
  {{ range .Data.Pages }}
  {{ $isArticle := and .IsPage (eq .Section "posts") }}
  {{ $isRecentArticle := and $isArticle (ge .Date.Unix $searchIndexFrom.Unix) }}
  {{ $isCorePage := or .IsHome (in (slice "/about/" "/editorial-policy/" "/jebo/" "/privacy/") .RelPermalink) }}
  {{ if and (not .Params.noindex) (or $isRecentArticle $isCorePage) }}
  {{ $page := . }}
  <url>
    <loc>{{ .Permalink }}</loc>
    {{ with .Lastmod }}<lastmod>{{ .Format "2006-01-02T15:04:05-07:00" }}</lastmod>{{ end }}
    {{ with .Params.image }}
    <image:image>
      <image:loc>{{ printf "%s%s" $page.Site.BaseURL (strings.TrimPrefix "/" .) }}</image:loc>
      <image:title>{{ $page.Title }}</image:title>
    </image:image>
    {{ end }}
    {{ with .Sitemap.ChangeFreq }}<changefreq>{{ . }}</changefreq>{{ end }}
    {{ if ge .Sitemap.Priority 0.0 }}<priority>{{ .Sitemap.Priority }}</priority>{{ end }}
  </url>
  {{ end }}
  {{ end }}
</urlset>
